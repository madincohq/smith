{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "rootDir": "..",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "noUncheckedIndexedAccess": false,
    "types": ["node"],
    "paths": {
      "@": ["../src/index.ts"],
      "@/*": ["../src/*"],
      "@madinco/smith": ["../src/index.ts"]
    }
  },
  "include": [".", "../commands", "../vitest.config.ts"]
}
