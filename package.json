{
  "name": "@madinco/smith",
  "version": "0.1.0",
  "description": "Artisan-style command runner for Node projects and personal workflows.",
  "type": "module",
  "license": "MIT",
  "author": "Madinco <oss@madinco.com>",
  "homepage": "https://github.com/madincohq/smith#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madincohq/smith.git"
  },
  "bugs": {
    "url": "https://github.com/madincohq/smith/issues"
  },
  "keywords": [
    "cli",
    "commands",
    "console",
    "artisan",
    "task-runner",
    "scaffolding"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "smith": "./bin/smith.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bin": "./bin/smith.js"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "smith": {
    "commands": "commands"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/stubs && cp src/stubs/*.stub dist/stubs/",
    "clean": "rm -rf dist",
    "smith": "node bin/smith.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tests",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.4"
  },
  "packageManager": "pnpm@11.1.0"
}
